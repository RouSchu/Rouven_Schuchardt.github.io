# Home Assistant MCP connection
# Copy this file to .env and fill in your real values. .env is gitignored and must never be committed.

# Base URL of your Home Assistant MCP endpoint.
# Only reachable from devices on your home network unless you expose it externally
# (e.g. via Nabu Casa Cloud or a reverse proxy with HTTPS).
HA_MCP_URL=http://homeassistant.local:8123/api/mcp

# Long-Lived Access Token, created under your HA profile: Profile -> Security -> Long-Lived Access Tokens
HA_MCP_TOKEN=
